{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/go/:id",
      "destination": "https://contentcam-hub.vercel.app/r/:id"
    }
  ],
  "redirects": [
    {
      "source": "/ios",
      "destination": "/get?c=ios",
      "permanent": false
    },
    {
      "source": "/get-preview",
      "destination": "/get-v5",
      "permanent": false
    }
  ]
}
